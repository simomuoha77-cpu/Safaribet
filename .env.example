# ─────────────────────────────────────────────────────────────────────────────
# SafariBet — Staff Assistance system (placeholders only; NEVER commit real values)
# Your existing variables (MONGO_URI, JWT secrets, M-Pesa keys, …) are unchanged.
# Set these in Render → Environment (or your server's .env, which is git-ignored).
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. false = /staff-assistance and /api/assistance answer 404.
ASSISTANCE_ADMIN_ENABLED=true

# Path of the portal (informational: the route is /staff-assistance).
ASSISTANCE_ADMIN_PATH=/staff-assistance

# REQUIRED, at least 32 characters. Used to (1) hash session tokens and (2) derive the key that encrypts 2FA secrets.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If this is missing or shorter than 32 characters the portal refuses to run (503). Changing it later signs every
# staff member out AND makes stored 2FA secrets unreadable (use "Reset 2FA" for each person afterwards).
ASSISTANCE_ADMIN_SESSION_SECRET=GENERATE_A_STRONG_RANDOM_SECRET

# Hard lifetime of a sign-in, and how long a tab may sit idle before it is signed out.
ASSISTANCE_ADMIN_SESSION_TTL=8h
ASSISTANCE_ADMIN_IDLE_TTL=30m

# true = every staff account must use a TOTP authenticator app (recommended). Individual accounts can also be forced on.
ASSISTANCE_ADMIN_REQUIRE_2FA=true

# Finance decisions at or above this amount (KES) need a second approver, besides reversal / manual credit / block.
ASSISTANCE_HIGH_RISK_AMOUNT=20000
