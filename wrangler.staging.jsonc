{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safaribet-staging",
  "keep_vars": true,
  "vars": {
    // STAGING ONLY: include the real error name/message in failed place-bet responses. Never set on production.
    "SB_DEBUG_ERRORS": "1"
  },
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATION_HUB",
        "class_name": "NotificationHub"
      },
      {
        "name": "BACKEND_RUNTIME",
        "class_name": "BackendRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-notification-hub",
      "new_sqlite_classes": [
        "NotificationHub"
      ]
    },
    {
      "tag": "v2-backend-runtime",
      "new_sqlite_classes": [
        "BackendRuntime"
      ]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/ws/*",
      "/.well-known/*",
      "/casino/*",
      "/staff-assistance*",
      "/casino-art/*",
      "/download/app.apk",
      // clean page URLs: served by the Worker (pageMap in cloudflare/worker.js). Without these, a refresh / deep link
      // on e.g. /deposit hit the SPA fallback and returned the HOME page.
      "/deposit",
      "/withdraw",
      "/my-bets",
      "/account",
      "/login",
      "/register",
      "/casino",
      "/virtual",
      "/referral",
      "/terms",
      "/privacy",
      "/responsible",
      "/contact",
      "/about",
      "/match",
      "/jackpot",
      // admin panel (token-gated in the Worker) and a block on direct access to its static HTML
      "/x9panel",
      "/x9panel/",
      "/pages/admin*"
    ]
  }
}
